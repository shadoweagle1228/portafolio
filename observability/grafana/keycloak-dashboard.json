{
  "title": "Keycloak - SLO",
  "uid": "keycloak-slo",
  "schemaVersion": 39,
  "refresh": "30s",
  "panels": [
    {
      "type": "stat", "title": "Replicas disponibles", "gridPos": {"x":0,"y":0,"w":6,"h":4},
      "targets": [{"expr": "kube_deployment_status_replicas_available{namespace=\"keycloak\",deployment=\"keycloak\"}"}]
    },
    {
      "type": "timeseries", "title": "Tasa de errores 5xx", "gridPos": {"x":6,"y":0,"w":9,"h":8},
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{namespace=\"keycloak\",status=~\"5..\"}[5m]))"}]
    },
    {
      "type": "timeseries", "title": "Latencia p95", "gridPos": {"x":15,"y":0,"w":9,"h":8},
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{namespace=\"keycloak\"}[5m])) by (le))"}]
    }
  ]
}
